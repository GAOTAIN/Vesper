{
  "name": "vesper",
  "version": "1.3.1",
  "description": "Vesper · 离线模拟、在线模型与本地部署聊天客户端",
  "main": "main.js",
  "author": "Vesper",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/prepare.cjs",
    "start": "electron .",
    "icons": "node scripts/generate-icon.cjs",
    "test": "node scripts/run.cjs test",
    "test:core": "node scripts/core-test.cjs",
    "test:simulation": "node scripts/simulation-test.cjs",
    "test:local": "node scripts/local-test.cjs",
    "test:local-integration": "node scripts/local-integration.cjs",
    "test:local-window": "node scripts/run.cjs local-test",
    "dist": "npm run icons && node scripts/run.cjs build",
    "test:installer": "node scripts/installer-test.cjs",
    "test:installer-window": "node scripts/run.cjs installer-test",
    "test:installer-network": "node scripts/installer-network-probe.cjs",
    "test:catalog-sources": "node scripts/catalog-source-test.cjs",
    "test:language": "node scripts/run.cjs language-test"
  },
  "dependencies": {
    "highlight.js": "11.12.0",
    "markdown-it": "15.0.3",
    "systeminformation": "5.33.15"
  },
  "devDependencies": {
    "electron": "43.8.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "sharp": "0.35.5"
  },
  "build": {
    "appId": "com.vesper.app",
    "productName": "Vesper",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "main/local/**/*",
      "renderer/**/*",
      "assets/icon.svg",
      "assets/models.json",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Vesper-${version}-portable.exe"
    }
  }
}
